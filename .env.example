# Snip environment variables.
# Copy to apps/web/.env.local (web) and apps/worker/.env (worker), then fill in.
# Never commit real values. In production, set web vars in Vercel → Project → Settings → Environment Variables.
# Variables starting with NEXT_PUBLIC_ are sent to the browser; everything else stays on the server.

# ---------- Supabase (Phase 2) ----------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Used by API routes, the worker and Edge Functions. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# ---------- App ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- LLM router (Phase 4) ----------
# Gemini free tier: orchestration, chat, vision checks. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides. Defaults: gemini-3.8-flash, then gemini-2.5-flash; reasoning effort "low" ("off" to omit).
GEMINI_MODEL=
GEMINI_REASONING_EFFORT=
# NVIDIA API Catalogue free tier: captions, hashtags, scripts. Key: https://build.nvidia.com
NVIDIA_API_KEY=
# Optional. Defaults: nvidia/llama-3.3-nemotron-super-49b-v1.5, then meta/llama-3.1-70b-instruct.
NVIDIA_MODEL=
# Optional local model via Ollama (OpenAI-compatible endpoint), for tagging and offline dev.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# ---------- Social OAuth (Phase 6) ----------
# Meta app (Instagram Business/Creator + Facebook Pages). Dev mode works with your own accounts.
META_APP_ID=
META_APP_SECRET=
# Google Cloud OAuth client (YouTube Data API v3 + YouTube Analytics API).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Render worker (apps/worker) ----------
SUPABASE_URL=https://<project-ref>.supabase.co
WORKER_ID=laptop-1
POLL_INTERVAL_SEC=5
